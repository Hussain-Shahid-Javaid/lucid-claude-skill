    {
      "id": "exp_e4e4002bf8b24c3381f5",
      "module": "consciousness",
      "title": "GW-1: global availability ablation (functional analogue)",
      "hypothesis": "Integration tasks causally depend on broadcast of module contents",
      "prediction": "broadcast \u226b no_broadcast on integration tasks; no difference on local tasks; scrambled and information-matched controls do not rescue integration",
      "config": {
        "basis": "Butlin et al. 2023 GWT-indicators (application-level analogue)",
        "capacity": 4,
        "conditions": [
          "broadcast",
          "no_broadcast",
          "scrambled",
          "matched_local_only"
        ],
        "modules": 4,
        "n": 400,
        "seed": 7
      },
      "result": {
        "accuracy": {
          "broadcast": {
            "integration": 1.0,
            "local": 1.0
          },
          "matched_local_only": {
            "integration": 0.0,
            "local": 1.0
          },
          "no_broadcast": {
            "integration": 0.0,
            "local": 1.0
          },
          "scrambled": {
            "integration": 0.0,
            "local": 0.0
          }
        },
        "claim_bounds": "In this deterministic architecture, broadcast is causally necessary for integration tasks. This is a property of the designed system, not evidence of experience.",
        "integration_effect_broadcast_minus_ablated": [
          1.0,
          1.0,
          1.0
        ],
        "local_effect_broadcast_minus_ablated": [
          0.0,
          0.0,
          0.0
        ],
        "n_integration": 202,
        "n_local": 198,
        "observations": [
          "scrambled broadcast also impaired LOCAL tasks (it overwrote modules' own correct facts), so the disruption control is not specific to integration"
        ]
      },
      "status": "empirically_supported",
      "criticism": "The dissociation is close to guaranteed by construction (modules only know their slices), so the experiment mainly validates the ablation/controls methodology. A stronger test needs learned modules whose dependence on broadcast is not designed in, e.g. an open-weight model with real activation access (see ActivationProbe).",
      "revision_of": null,
      "cost": {},
      "created_at": "2026-10-28T00:51:47.737815Z",
      "updated_at": "2026-10-28T00:51:48.241199Z"
    },
