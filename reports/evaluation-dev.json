            "local": 1.0
          },
          "no_broadcast": {
            "integration": 0.0,
            "local": 1.0
          },
          "scrambled": {
            "integration": 0.0,
            "local": 0.0
          }
        },
        "claim_bounds": "In this deterministic architecture, broadcast is causally necessary for integration tasks. This is a property of the designed system, not evidence of experience.",
        "integration_effect_broadcast_minus_ablated": [
